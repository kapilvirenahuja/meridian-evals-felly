# Database
DATABASE_URL=YOUR_DATABASE_URL_HERE

# Redis
REDIS_URL=YOUR_REDIS_URL_HERE

# JWT
JWT_SECRET=YOUR_JWT_SECRET_HERE

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=1.0.0

# Search provider — 'prisma' (default, no Docker needed) or 'opensearch'
SEARCH_PROVIDER=prisma

# OpenSearch (only needed when SEARCH_PROVIDER=opensearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_NAME=mentor_profiles
